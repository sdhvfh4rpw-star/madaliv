VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SMS Twilio (optionnel — simulation si absent)
VITE_TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_TOKEN=your-auth-token
VITE_TWILIO_PHONE=+12015551234

# Mobile Money Madagascar (optionnel — simulation si absent)
VITE_MVOLA_KEY=your-mvola-merchant-key
VITE_ORANGE_KEY=your-orange-money-merchant-key

# Google Maps Places (optionnel — fallback liste statique si absent)
# Console Google Cloud > APIs > Maps JavaScript API + Places API
VITE_GOOGLE_MAPS_KEY=AIzaSy...

# Firebase Cloud Messaging (optionnel — toasts simulés si absent)
# Valeurs disponibles dans : Firebase Console > Project Settings > Web App
VITE_FIREBASE_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_VAPID_KEY=BNt...  # Project Settings > Cloud Messaging > Web Push Certificates

# Sentry — surveillance des erreurs (optionnel — désactivé si absent)
# Sentry.io > Project > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
